# Zirve runs entirely on bundled fixtures with none of these set.
# Fill in a group and that part of the app switches to live data.

# ── SERP positions, search volume, keyword difficulty ─────────────────────
# https://docs.dataforseo.com/v3/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Real impressions / clicks / average position for a verified property ──
# https://developers.google.com/webmaster-tools/search-console-api-original
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# ── Technical audit findings and crawled page count ───────────────────────
# https://crawlee.dev/docs/quick-start
CRAWLER_API_URL=
CRAWLER_API_KEY=

# ── Auth and durable rank history ─────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
